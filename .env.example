# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (Razorpay)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public Test Mode key. Must match RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Test checkout is opt-in and restricted to admins or this UUID allowlist.
RAZORPAY_TEST_CHECKOUT_ENABLED=false
RAZORPAY_TEST_USER_IDS=

# Optional build output directory for Next.js
DIST_DIR=.next
